<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs MadPlan with gunicorn on 127.0.0.1:8000, starting at login and restarting if it stops.
     Install: cp to ~/Library/LaunchAgents, then launchctl bootstrap gui/$(id -u) <that path> -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.prayushdesai.madplan</string>
    <key>WorkingDirectory</key><string>/Users/prayushdesai/Desktop/madplan/src</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/prayushdesai/Desktop/madplan/venv/bin/gunicorn</string>
        <string>--bind</string><string>127.0.0.1:8000</string>
        <string>--workers</string><string>3</string>
        <string>--timeout</string><string>180</string>
        <string>app:app</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/Users/prayushdesai/Library/Logs/madplan/server.log</string>
    <key>StandardErrorPath</key><string>/Users/prayushdesai/Library/Logs/madplan/server.log</string>
</dict>
</plist>
